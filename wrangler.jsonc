{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "portfolio-2",
	"compatibility_date": "2026-09-09",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b69d0abfcb064666828a2b695355f9de",
			"remote": true
		}
	],
	
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
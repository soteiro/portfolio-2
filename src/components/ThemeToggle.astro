---
// ThemeToggle.astro — selector de tema oscuro / claro
---

<button
  id="theme-toggle"
  class="inline-flex items-center justify-center w-11 h-11 p-0 border border-card-border rounded bg-surface text-page-text cursor-pointer transition-[border-color,color,background-color] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-primary hover:text-primary"
  type="button"
  aria-label="Cambiar a tema claro"
  title="Cambiar a tema claro"
>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="hidden dark:block"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>
  <svg
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="block dark:hidden"
    aria-hidden="true"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script>
  let themeController: AbortController | null = null;

  function setupThemeToggle() {
    themeController?.abort();
    themeController = new AbortController();
    const { signal } = themeController;

    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    const syncState = () => {
      const isDark = (document.documentElement.getAttribute('data-color-mode') || 'dark') === 'dark';
      const label = isDark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro';
      btn.setAttribute('aria-label', label);
      btn.setAttribute('title', label);
    };

    syncState();

    btn.addEventListener(
      'click',
      () => {
        const root = document.documentElement;
        const currentMode = root.getAttribute('data-color-mode') || 'dark';
        const newMode = currentMode === 'dark' ? 'light' : 'dark';

        root.setAttribute('data-color-mode', newMode);
        try {
          localStorage.setItem('saved-color-theme', newMode);
        } catch {
          // Storage unavailable
        }
        syncState();
      },
      { signal }
    );
  }

  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

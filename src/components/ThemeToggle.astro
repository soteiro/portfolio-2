---
// ThemeToggle.astro
// Josh W. Comeau's animated sun/moon theme switcher
---

<button
  id="theme-toggle"
  class="relative flex items-center justify-center w-9 h-9 p-0 border-0 rounded-full bg-transparent text-page-text cursor-pointer outline-offset-2 transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:scale-110 active:scale-95"
  type="button"
  aria-label="Toggle color mode"
  title="Toggle dark / light mode"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    class="theme-icon block overflow-visible stroke-2 rotate-90 dark:rotate-40 transition-transform duration-500 ease-[cubic-bezier(0.17,0.67,0.35,1.35)]"
  >
    <mask id="sun-dot-mask">
      <rect x="-10" y="-10" width="44" height="44" fill="#FFF"></rect>
      <circle r="6" cx="12" cy="12" fill="#000"></circle>
    </mask>
    <mask id="moon-cutout">
      <rect x="0" y="0" width="24" height="24" fill="#FFF"></rect>
      <circle id="moon-cutout-circle" cx="12" cy="4" r="7" fill="#000" class="transition-transform duration-400 ease-[cubic-bezier(0.17,0.67,0.35,1.35)] -translate-x-2.5 -translate-y-2.5 dark:translate-x-0 dark:translate-y-0"></circle>
    </mask>

    <!-- Sun rays -->
    <g class="sun-rays origin-center transition-all duration-400 ease-[cubic-bezier(0.17,0.67,0.35,1.35)] dark:opacity-0 dark:scale-0" mask="url(#sun-dot-mask)">
      <circle cx="22" cy="12" r="1.5" fill="currentColor"></circle>
      <circle cx="19.071" cy="19.071" r="1.5" fill="currentColor"></circle>
      <circle cx="12" cy="22" r="1.5" fill="currentColor"></circle>
      <circle cx="4.929" cy="19.071" r="1.5" fill="currentColor"></circle>
      <circle cx="2" cy="12" r="1.5" fill="currentColor"></circle>
      <circle cx="4.929" cy="4.929" r="1.5" fill="currentColor"></circle>
      <circle cx="12" cy="2" r="1.5" fill="currentColor"></circle>
      <circle cx="19.071" cy="4.929" r="1.5" fill="currentColor"></circle>
    </g>

    <!-- Center orb / Moon crescent -->
    <circle
      class="sun-moon-center origin-center transition-all duration-400 ease-[cubic-bezier(0.17,0.67,0.35,1.35)] dark:[r:9]"
      cx="12"
      cy="12"
      r="5"
      fill="currentColor"
      mask="url(#moon-cutout)"
    ></circle>
  </svg>
</button>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById('theme-toggle');
    if (!btn) return;

    btn.addEventListener('click', () => {
      const root = document.documentElement;
      const currentMode = root.getAttribute('data-color-mode') || 'light';
      const newMode = currentMode === 'dark' ? 'light' : 'dark';

      root.setAttribute('data-color-mode', newMode);
      localStorage.setItem('saved-color-theme', newMode);

      // Trigger custom event for sounds
      window.dispatchEvent(new CustomEvent('theme-change', { detail: { mode: newMode } }));
    });
  }

  // Run on first load and view transitions
  setupThemeToggle();
  document.addEventListener('astro:after-swap', setupThemeToggle);
</script>

---
// SoundToggle.astro
// Josh W. Comeau's whimsical speaker sound effect toggle with Web Audio synthesizer
---

<button
  id="sound-toggle"
  class="group/sound sound-toggle-btn relative flex items-center justify-center w-9 h-9 p-0 border-0 rounded-full bg-transparent text-page-text cursor-pointer outline-offset-2 transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:scale-110 active:scale-95 data-[enabled=false]:text-gray-500"
  type="button"
  aria-label="Toggle sound effects"
  title="Toggle sound effects"
  data-enabled="true"
>
  <svg
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    class="speaker-icon block overflow-visible"
  >
    <!-- Speaker base -->
    <g class="speaker-body-group">
      <path
        d="M12.0133 4.60757C11.9149 4.2957 11.5463 4.19331 11.2861 4.39151L5.93425 8.46914C5.84716 8.5355 5.74071 8.57143 5.63123 8.57143H1.5C1.22386 8.57143 1 8.79529 1 9.07143V14.9286C1 15.2047 1.22386 15.4286 1.5 15.4286H5.63123C5.74071 15.4286 5.84716 15.4645 5.93425 15.5309L11.2861 19.6085C11.5463 19.8067 11.9149 19.7043 12.0133 19.3924C12.3582 18.2999 13 15.7612 13 12C13 8.2388 12.3582 5.70014 12.0133 4.60757Z"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="speaker-shape origin-[30%_center] group-[.wiggle]/sound:animate-[speakerWiggle_0.35s_ease-in-out]"
      ></path>
    </g>

    <!-- Inner Wave Arc -->
    <g class="sound-wave transition-all duration-200 delay-50 group-data-[enabled=false]/sound:opacity-0 group-data-[enabled=false]/sound:-translate-x-1">
      <path
        d="M 17.54 8.46 C 18.48 9.4 19 10.67 19 12 C 19 13.32 18.48 14.59 17.54 15.53"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </g>

    <!-- Outer Wave Arc -->
    <g class="sound-wave transition-all duration-200 delay-150 group-data-[enabled=false]/sound:opacity-0 group-data-[enabled=false]/sound:-translate-x-1">
      <path
        d="M 20.07 4.93 C 21.95 6.81 23 9.35 23 12 C 23 14.65 21.95 17.19 20.07 19.07"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      ></path>
    </g>
  </svg>
</button>

<script>
  class WhimsicalAudio {
    ctx: AudioContext | null = null;
    enabled: boolean = true;

    constructor() {
      const stored = localStorage.getItem('sound-enabled');
      this.enabled = stored !== null ? stored === 'true' : true;
    }

    private initContext() {
      if (!this.ctx && typeof window !== 'undefined') {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AudioCtx) {
          this.ctx = new AudioCtx();
        }
      }
      if (this.ctx && this.ctx.state === 'suspended') {
        this.ctx.resume();
      }
    }

    playBoop(freq = 480, duration = 0.08) {
      if (!this.enabled) return;
      try {
        this.initContext();
        if (!this.ctx) return;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, this.ctx.currentTime);
        osc.frequency.exponentialRampToValueAtTime(freq * 1.5, this.ctx.currentTime + duration);

        gain.gain.setValueAtTime(0.12, this.ctx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + duration);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start();
        osc.stop(this.ctx.currentTime + duration);
      } catch (e) {
        // AudioContext ignored if blocked
      }
    }

    playThemeSound(isDark: boolean) {
      if (!this.enabled) return;
      try {
        this.initContext();
        if (!this.ctx) return;

        const now = this.ctx.currentTime;
        const baseFreq = isDark ? 320 : 640;
        const targetFreq = isDark ? 220 : 880;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.exponentialRampToValueAtTime(targetFreq, now + 0.15);

        gain.gain.setValueAtTime(0.1, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.15);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start();
        osc.stop(now + 0.15);
      } catch (e) {}
    }
  }

  const audioEngine = new WhimsicalAudio();

  function setupSoundToggle() {
    const btn = document.getElementById('sound-toggle') as HTMLButtonElement | null;
    if (!btn) return;

    btn.setAttribute('data-enabled', audioEngine.enabled.toString());

    btn.addEventListener('click', () => {
      audioEngine.enabled = !audioEngine.enabled;
      localStorage.setItem('sound-enabled', audioEngine.enabled.toString());
      btn.setAttribute('data-enabled', audioEngine.enabled.toString());

      // Trigger wiggle animation
      btn.classList.remove('wiggle');
      void btn.offsetWidth; // reflow
      btn.classList.add('wiggle');

      if (audioEngine.enabled) {
        audioEngine.playBoop(520, 0.1);
      }
    });

    // Listen for theme switch events
    window.addEventListener('theme-change', ((e: CustomEvent) => {
      audioEngine.playThemeSound(e.detail.mode === 'dark');
    }) as EventListener);

    // Add playful sound to all .josh-button and .whimsical-link clicks
    document.querySelectorAll('.josh-button, .category-chip, .popular-link').forEach((el) => {
      el.addEventListener('click', () => {
        audioEngine.playBoop(400 + Math.random() * 200, 0.07);
      });
    });
  }

  setupSoundToggle();
  document.addEventListener('astro:after-swap', setupSoundToggle);
</script>

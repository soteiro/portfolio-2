---
// ProjectCard.astro — Tarjeta estilo Event Summary con stretched-link y 2 columnas limpias de metadatos
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
  trackCode?: string;
}

const { project, trackCode } = Astro.props;
const visibleTags = project.tags.slice(0, 4);
const extraCount = Math.max(0, project.tags.length - visibleTags.length);
const projectHref = project.id ? `/projects/${project.id}` : (project.demoUrl || project.githubUrl || '#');
---

<article
  class="project-card group relative flex flex-col justify-between gap-5 p-6 bg-surface border border-card-border rounded-md transition-[border-color,background-color] duration-200 ease-[cubic-bezier(0.16,1,0.3,1)] hover:border-border-strong min-w-0"
  data-category={project.category.trim().toLowerCase()}
>
  <div class="flex items-start justify-between gap-4 min-w-0">
    <div class="flex flex-col gap-2 min-w-0 flex-1">
      <h3 class="font-display text-xl sm:text-2xl font-bold leading-snug text-page-text m-0">
        <a
          href={projectHref}
          class="text-inherit no-underline transition-colors duration-150 group-hover:text-primary hover:underline after:content-[''] after:absolute after:inset-0"
        >
          {project.title}
        </a>
      </h3>

      {project.subtitle && (
        <p class="text-[0.9375rem] font-medium text-text-muted leading-snug m-0">
          {project.subtitle}
        </p>
      )}
    </div>

    {project.featured && (
      <div class="flex flex-col gap-1 pt-1 shrink-0" aria-hidden="true">
        <span class="w-1.5 h-3.5 rounded-[1px] bg-signal"></span>
        <span class="w-1.5 h-3 rounded-[1px] bg-secondary"></span>
        <span class="w-1.5 h-2.5 rounded-[1px] bg-ring"></span>
        <span class="w-1.5 h-3 rounded-[1px] bg-status-ok"></span>
      </div>
    )}
  </div>

  <!-- Metadatos en 2 columnas limpias (con código de traza cuando aplica) -->
  <dl class="grid grid-cols-2 gap-x-4 gap-y-1.5 py-2.5 border-y border-card-border text-xs m-0">
    <div class="flex flex-col gap-0.5">
      <dt class="text-text-muted font-medium">Especialidad</dt>
      <dd class="font-semibold text-secondary m-0">
        {project.category}{trackCode ? <span class="tabular-data text-text-muted font-normal"> · {trackCode}</span> : ''}
      </dd>
    </div>
    <div class="flex flex-col gap-0.5">
      <dt class="text-text-muted font-medium">Periodo</dt>
      <dd class="tabular-data font-medium text-page-text m-0">{project.year ?? 'En curso'}</dd>
    </div>
  </dl>

  <p class="text-[0.9375rem] leading-relaxed text-page-text/90 m-0">
    {project.description}
  </p>

  <!-- Franja inferior: stack + enlaces siempre alineados a la derecha con objetivos táctiles >=44px -->
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 pt-3 border-t border-card-border">
    <p class="tabular-data text-xs text-text-muted m-0 min-w-0">
      {visibleTags.join(' · ')}{extraCount > 0 ? ` · +${extraCount}` : ''}
    </p>

    <div class="flex items-center gap-3 ml-auto shrink-0">
      {project.demoUrl && (
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 inline-flex items-center gap-1 min-h-11 px-1 text-sm font-medium text-text-muted hover:text-page-text transition-colors"
          aria-label={`Ver demo en vivo de ${project.title}`}
        >
          <span>Demo</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )}
      {project.githubUrl && (
        <a
          href={project.githubUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="relative z-10 inline-flex items-center gap-1 min-h-11 px-1 text-sm font-medium text-text-muted hover:text-page-text transition-colors"
          aria-label={`Ver código fuente de ${project.title}`}
        >
          <span>Código</span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )}
      <span
        class="inline-flex items-center gap-1 min-h-11 text-sm font-display font-bold text-primary group-hover:underline"
        aria-hidden="true"
      >
        <span>Ver proyecto</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14"></path>
          <path d="m12 5 7 7-7 7"></path>
        </svg>
      </span>
    </div>
  </div>
</article>

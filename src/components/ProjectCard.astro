---
// ProjectCard.astro
// Josh W. Comeau signature card with hover underline, tag pills, and cascading chevron arrows
import type { Project } from '../data/portfolio';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="josh-card group relative flex flex-col gap-4 p-8 bg-card-bg border border-card-border rounded-2xl shadow-sm transition duration-250 hover:-translate-y-1 hover:shadow-xl hover:border-primary" data-category={project.category.toLowerCase()}>
  <div>
    <div class="flex items-center gap-2 mb-2">
      <span class="text-xs font-bold uppercase tracking-wider text-secondary">{project.category}</span>
      {project.year && <span class="text-xs text-text-muted">{project.year}</span>}
      {project.featured && <span class="text-xs font-medium px-2 py-0.5 rounded-full bg-warning-100 dark:bg-warning-300 text-warning-700">★ Destacado</span>}
    </div>

    <!-- Title with hover underline effect -->
    <h3 class="m-0 text-2xl font-bold leading-snug">
      <a href={project.demoUrl || project.githubUrl || "#"} target="_blank" rel="noopener noreferrer" class="text-page-text hover:underline hover:decoration-[2.5px] hover:decoration-primary hover:underline-offset-[3px] hover:text-primary transition-colors duration-200">
        {project.title}
      </a>
    </h3>

    {project.subtitle && (
      <p class="mt-1.5 text-base font-medium text-text-muted m-0">{project.subtitle}</p>
    )}
  </div>

  <p class="text-base leading-relaxed text-page-text m-0">{project.description}</p>

  <!-- Tech tags -->
  <div class="flex flex-wrap gap-2">
    {project.tags.map((tag) => (
      <span class="text-[0.8125rem] font-mono px-2.5 py-1 rounded-md bg-cloud-300 dark:bg-cloud-500 dark:border dark:border-gray-300 text-page-text transition-colors duration-200">#{tag}</span>
    ))}
  </div>

  <!-- Footer with Read More / View Demo & Cascading Chevron Arrows -->
  <div class="flex items-center justify-between pt-3 border-t border-card-border">
    <a
      href={project.demoUrl || project.githubUrl || "#"}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-2 text-[0.9375rem] font-bold text-primary no-underline relative"
    >
      <span>Ver proyecto</span>
      <div class="relative w-9 h-3" aria-hidden="true">
        <svg width="36" height="12" viewBox="0 0 36 12" fill="none" class="absolute top-0 left-0">
          <!-- Chevron 1 -->
          <path
            d="M0.75 6H11.25 M6 0.75L11.25 6L6 11.25"
            class="stroke-primary stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round] opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-hover:delay-0"
          ></path>
          <!-- Chevron 2 -->
          <path
            d="M15 10L19.5 5.5L15 1"
            class="stroke-primary stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round] opacity-0 transition-opacity duration-150 group-hover:opacity-100 group-hover:delay-100"
          ></path>
          <!-- Chevron 3 -->
          <path
            d="M23 10L27.5 5.5L23 1"
            stroke-opacity="0.66"
            class="stroke-primary stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round] opacity-0 transition-opacity duration-150 group-hover:opacity-70 group-hover:delay-200"
          ></path>
          <!-- Chevron 4 -->
          <path
            d="M31 10L35.5 5.5L31 1"
            stroke-opacity="0.35"
            class="stroke-primary stroke-[1.5] [stroke-linecap:round] [stroke-linejoin:round] opacity-0 transition-opacity duration-150 group-hover:opacity-40 group-hover:delay-300"
          ></path>
        </svg>
      </div>
    </a>

    {project.githubUrl && (
      <a
        href={project.githubUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 text-sm text-text-muted hover:text-page-text transition-colors duration-200"
        aria-label="Ver código fuente"
        title="Código fuente"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path>
        </svg>
        <span>Código</span>
      </a>
    )}
  </div>
</article>

---
import Rainbow from './Rainbow.astro';
import { portfolioData } from '../data/portfolio';
---

<section class="relative grid grid-cols-1 lg:grid-cols-[1.1fr_1fr] gap-10 lg:gap-14 items-center pt-2 sm:pt-6 pb-10 sm:pb-10">
  <!-- Left Column: Friendly Greeting & CTAs -->
  <div class=" flex flex-col gap-6 relative z-10">
    <!-- Status Pill -->
    <!-- <div class="inline-flex items-center gap-2 px-3.5 py-1.5 w-fit bg-cloud-300/80 dark:bg-cloud-500/80 backdrop-blur-sm border border-cloud-400 dark:border-white/10 rounded-full text-sm font-medium text-page-text shadow-sm">
      <span class="w-2 h-2 rounded-full bg-success-500 ring-2 ring-success-300 animate-pulse"></span>
      <span>{portfolioData.status}</span>
    </div> -->

    <!-- Friendly Greeting -->
    <!-- <h1 class="flex flex-col gap-3 m-0">
      <span class="block text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-tight text-page-text">
        ¡Hola! Soy <span class="text-primary">{portfolioData.name.first}</span>. 👋
      </span>
      <span class="block text-xl sm:text-2xl font-medium leading-snug bg-gradient-br from-primary to-secondary bg-clip-text text-transparent">
        {portfolioData.tagline}
      </span>
    </h1> -->

    <!--
      La home no tiene encabezado visible desde que se comentó el saludo del
      hero, y una página sin <h1> pierde su señal más fuerte de tema — más aún
      siendo la raíz del dominio. Este h1 solo para lectores de pantalla y
      buscadores repone esa señal sin alterar el diseño. Si en algún momento
      volvés a mostrar el saludo, quitá este bloque y dejá aquel como h1.
    -->
    <h1 class="sr-only">
      {portfolioData.name.display} — {portfolioData.role}. {portfolioData.tagline}
    </h1>

    <!-- Short Bio -->
    <p class="text-lg text-text-muted max-w-xl leading-relaxed m-0">
      {portfolioData.bio}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4 items-center pt-2">
      <a href="#projects" class="josh-button">
        <span>Explorar proyectos</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
      <a href="#contact" class="josh-button josh-button-secondary">
        <span>Contactar</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Right Column: Whimsical Interactive Rainbow & Sitting Mascot -->
  <div class="relative flex flex-col items-center justify-center select-none pt-4 lg:pt-0 z-10">
    <!-- Interactive Rainbow Arch -->
    <div class="w-full flex justify-center items-center">
      <Rainbow />
    </div>

    <!-- Sitting Mascot directly in front of the Rainbow -->
    <!-- <div class="relative -mt-32 sm:-mt-38 md:-mt-44 z-10 flex flex-col items-center pointer-events-none">
      <img
        src="/images/avatar.png"
        alt={portfolioData.name.display}
        width="280"
        height="280"
        class="w-44 h-44 sm:w-56 sm:h-56 md:w-64 md:h-64 object-contain filter drop-shadow-[0_16px_22px_rgba(0,0,0,0.35)]"
        loading="eager"
        decoding="async"
      />-->
      <!-- Soft ground contact shadow resting on the hill curve -->
      <!--  <div class="w-32 sm:w-40 h-3 bg-black/25 dark:bg-black/40 rounded-[100%] blur-[6px] -mt-2"></div>
    </div> -->
  </div>
</section>  
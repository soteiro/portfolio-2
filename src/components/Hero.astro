---
// Hero.astro
import Rainbow from './Rainbow.astro';
import { portfolioData } from '../data/portfolio';
---

<section class="relative grid grid-cols-1 lg:grid-cols-[1.2fr_1fr] gap-10 lg:gap-12 items-center pt-4 sm:pt-8 pb-16">
  <div class="flex flex-col gap-6">
    <!-- Status Pill -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 w-fit bg-cloud-300 dark:bg-cloud-500 dark:border dark:border-gray-300 rounded-full text-sm font-medium text-page-text">
      <span class="w-2 h-2 rounded-full bg-success-500 ring-2 ring-success-300 animate-pulse"></span>
      <span>{portfolioData.status}</span>
    </div>

    <!-- Friendly Greeting -->
    <h1 class="flex flex-col gap-3 m-0">
      <span class="block text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-tight text-page-text">
        ¡Hola! Soy <span class="text-primary">{portfolioData.name.first}</span>. 👋
      </span>
      <span class="block text-xl sm:text-2xl font-medium leading-snug bg-gradient-br from-primary to-secondary bg-clip-text text-transparent">
        {portfolioData.tagline}
      </span>
    </h1>

    <!-- Short Bio -->
    <p class="text-lg text-text-muted max-w-xl leading-relaxed m-0">
      {portfolioData.bio}
    </p>

    <!-- CTAs -->
    <div class="flex flex-wrap gap-4 items-center pt-2">
      <a href="#projects" class="josh-button">
        <span>Explorar proyectos</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="5" x2="12" y2="19"></line>
          <polyline points="19 12 12 19 5 12"></polyline>
        </svg>
      </a>
      <a href="#contact" class="josh-button josh-button-secondary">
        <span>Contactar</span>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="5" y1="12" x2="19" y2="12"></line>
          <polyline points="12 5 19 12 12 19"></polyline>
        </svg>
      </a>
    </div>
  </div>

  <!-- Whimsical Interactive Rainbow & Mascot Hero Box -->
  <div class="flex justify-center items-center">
    <div class="relative w-full max-w-460px flex flex-col items-center px-4 pt-7 pb-5 bg-card-bg border-2 border-dashed border-cloud-500 rounded-[28px] shadow-lg hover:-translate-y-1 hover:shadow-2xl transition duration-300">
      <div class="absolute text-xl select-none pointer-events-none top-4 right-6 animate-[sparkleFloat_3s_ease-in-out_infinite]">✨</div>
      <div class="absolute text-xl select-none pointer-events-none bottom-8 left-6 animate-[sparkleFloat_3s_ease-in-out_infinite_1s]">🎨</div>
      <div class="absolute text-xl select-none pointer-events-none top-8 left-4 animate-[sparkleFloat_3s_ease-in-out_infinite_2s]">🚀</div>

      <!-- Interactive Animated Rainbow that tracks cursor -->
      <Rainbow />

      <!-- Caption with Avatar -->
      <div class="flex items-center gap-3 mt-3 px-4 py-2 bg-cloud-300 dark:bg-cloud-500 dark:border dark:border-gray-300 rounded-full">
        <div class="w-8 h-8 shrink-0">
          <svg viewBox="0 0 40 40" class="w-full h-full" fill="none" aria-hidden="true">
            <circle cx="20" cy="20" r="18" fill="var(--color-primary)" />
            <circle cx="15" cy="17" r="2.5" fill="#ffffff" />
            <circle cx="25" cy="17" r="2.5" fill="#ffffff" />
            <path d="M16 23C18 26 22 26 24 23" stroke="#ffffff" stroke-width="2" stroke-linecap="round" />
            <circle cx="13" cy="21" r="1.5" fill="var(--color-secondary)" opacity="0.7" />
            <circle cx="27" cy="21" r="1.5" fill="var(--color-secondary)" opacity="0.7" />
          </svg>
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-bold text-page-text leading-tight">{portfolioData.role}</span>
          <span class="text-xs text-text-muted">{portfolioData.location}</span>
        </div>
      </div>
    </div>
  </div>
</section>

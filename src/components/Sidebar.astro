---
// Sidebar.astro — Contacto directo
import { portfolioData } from '../data/portfolio';
---

<aside class="flex flex-col gap-5 min-w-0 lg:pt-[4.25rem]">
  <!-- Contacto directo -->
  <section
    class="p-6 bg-surface border border-border-strong rounded-md flex flex-col gap-4 min-w-0"
    id="contact"
  >
    <div class="flex flex-col gap-1.5">
      <h2 class="font-display text-xl font-bold text-page-text m-0">¿Hablamos de ingeniería?</h2>
      <p class="text-sm text-text-muted leading-relaxed m-0">
        Disponible para entrevistas de ingeniería backend/sistemas y proyectos técnicos de Linux o telemetría IoT.
      </p>
      <p class="inline-flex items-center gap-2 text-xs font-medium text-text-muted pt-1 m-0">
        <span class="w-2 h-2 rounded-full bg-status-ok shrink-0" aria-hidden="true"></span>
        <span>Valdivia, CL (UTC-3/-4) · Remoto y proyectos</span>
      </p>
    </div>

    <div class="flex flex-col gap-2 min-w-0">
      <a href={`mailto:${portfolioData.social.email}`} class="telemetry-btn-primary w-full">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
          <rect width="20" height="16" x="2" y="4" rx="2"></rect>
          <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
        </svg>
        <span>Escribir correo</span>
      </a>

      <button
        type="button"
        id="copy-email-btn"
        data-email={portfolioData.social.email}
        class="inline-flex items-center justify-between gap-2 min-h-11 px-3.5 py-2 rounded bg-page border border-card-border text-sm text-page-text cursor-pointer transition-colors duration-150 hover:border-primary min-w-0"
        aria-describedby="copy-email-status"
      >
        <span class="font-mono text-xs truncate">{portfolioData.social.email}</span>
        <span class="shrink-0 inline-flex items-center gap-1.5 text-xs font-semibold text-primary">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
            <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
          </svg>
          <span data-copy-label>Copiar</span>
        </span>
      </button>

      <p id="copy-email-status" role="status" aria-live="polite" class="min-h-4 text-xs text-text-muted m-0"></p>
    </div>

    <div class="grid grid-cols-2 gap-2.5 -mt-1 pt-3 border-t border-card-border">
      {portfolioData.social.linkedin && (
        <a
          href={portfolioData.social.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="telemetry-btn-secondary text-sm"
        >
          <span>LinkedIn<span class="sr-only"> (abre en una nueva pestaña)</span></span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )}
      {portfolioData.social.github && (
        <a
          href={portfolioData.social.github}
          target="_blank"
          rel="noopener noreferrer"
          class="telemetry-btn-secondary text-sm"
        >
          <span>GitHub<span class="sr-only"> (abre en una nueva pestaña)</span></span>
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M7 17 17 7"></path>
            <path d="M7 7h10v10"></path>
          </svg>
        </a>
      )}
    </div>
  </section>
</aside>

<script>
  let sidebarController: AbortController | null = null;
  let copyResetTimer: number | null = null;

  function setupSidebar() {
    sidebarController?.abort();
    sidebarController = new AbortController();
    const { signal } = sidebarController;

    const copyBtn = document.getElementById('copy-email-btn') as HTMLButtonElement | null;
    const statusEl = document.getElementById('copy-email-status');
    const labelEl = copyBtn?.querySelector<HTMLElement>('[data-copy-label]');

    if (copyBtn && statusEl) {
      copyBtn.addEventListener(
        'click',
        async () => {
          const email = copyBtn.getAttribute('data-email') ?? '';
          if (!email) return;

          if (copyResetTimer !== null) {
            window.clearTimeout(copyResetTimer);
            copyResetTimer = null;
          }

          let copied = false;
          try {
            if (navigator.clipboard?.writeText) {
              await navigator.clipboard.writeText(email);
              copied = true;
            }
          } catch {
            copied = false;
          }

          if (!copied) {
            try {
              const textarea = document.createElement('textarea');
              textarea.value = email;
              textarea.setAttribute('readonly', '');
              textarea.style.position = 'fixed';
              textarea.style.opacity = '0';
              document.body.appendChild(textarea);
              textarea.select();
              copied = document.execCommand('copy');
              document.body.removeChild(textarea);
            } catch {
              copied = false;
            }
          }

          if (copied) {
            if (labelEl) labelEl.textContent = 'Copiado';
            statusEl.setAttribute('role', 'status');
            statusEl.classList.remove('text-energy');
            statusEl.classList.add('text-text-muted');
            statusEl.textContent = `Correo ${email} copiado al portapapeles.`;

            copyResetTimer = window.setTimeout(() => {
              if (labelEl) labelEl.textContent = 'Copiar';
              statusEl.textContent = '';
              copyResetTimer = null;
            }, 2500);
          } else {
            if (labelEl) labelEl.textContent = 'Copiar';
            statusEl.setAttribute('role', 'alert');
            statusEl.classList.remove('text-text-muted');
            statusEl.classList.add('text-energy');
            statusEl.textContent = `No se pudo copiar automáticamente. Usa el botón de correo o copia ${email} manualmente.`;
          }
        },
        { signal }
      );
    }
  }

  setupSidebar();
  document.addEventListener('astro:after-swap', setupSidebar);
</script>

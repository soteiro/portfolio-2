---
// Sidebar.astro
// Josh W. Comeau sidebar with Category filter tags, Popular/Featured items, and Contact/Newsletter callout
import { portfolioData } from '../data/portfolio';
import { getHighlights } from '../data/highlights';

const highlights = await getHighlights();
---

<aside class="flex flex-col gap-14">
  <!-- 1. Categories / Skills Filter Section -->
  <section class="flex flex-col gap-5" id="skills">
    <h2 class="text-sm font-bold uppercase tracking-[0.125rem] text-secondary m-0">Filtrar por Especialidad</h2>
    <div class="flex flex-wrap gap-2" id="category-filter-group">
      <button
        class="category-chip active relative inline-flex items-center px-3.5 py-1.5 text-sm font-medium text-page-text bg-transparent border-0 cursor-pointer rounded-lg transition duration-200 hover:-translate-y-0.5 hover:text-primary [&.active]:text-white [&.active_.chip-bg]:bg-primary [&.active_.chip-bg]:border-primary"
        data-filter="all"
      >
        <span class="chip-bg absolute inset-0 -z-10 rounded-lg bg-cloud-300 dark:bg-cloud-500 dark:border dark:border-gray-300 transition duration-200"></span>
        <span>Todos los proyectos</span>
      </button>
      {portfolioData.categories.map((cat) => (
        <button
          class="category-chip relative inline-flex items-center px-3.5 py-1.5 text-sm font-medium text-page-text bg-transparent border-0 cursor-pointer rounded-lg transition duration-200 hover:-translate-y-0.5 hover:text-primary [&.active]:text-white [&.active_.chip-bg]:bg-primary [&.active_.chip-bg]:border-primary"
          data-filter={cat.slug}
        >
          <span class="chip-bg absolute inset-0 -z-10 rounded-lg bg-cloud-300 dark:bg-cloud-500 dark:border dark:border-gray-300 transition duration-200"></span>
          <span>{cat.name}</span>
        </button>
      ))}
    </div>
  </section>

  <!-- 2. Highlights / Popular Content -->
  <section class="flex flex-col gap-5 sticky top-28">
    {highlights.length > 0 && (
    <Fragment>
    <h2 class="text-sm font-bold uppercase tracking-[0.125rem] text-secondary m-0">Destacados</h2>
    <ol class="flex flex-col gap-4 list-none p-0 m-0">
      {highlights.map((item) => (
        <li>
          <a
            href={item.url}
            target={item.external ? '_blank' : undefined}
            rel={item.external ? 'noopener noreferrer' : undefined}
            class="group flex items-start gap-3 text-base font-medium leading-snug text-page-text transition duration-200 hover:text-primary hover:translate-x-1"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="shrink-0 mt-[0.2rem] text-decorative transition duration-200 group-hover:text-primary group-hover:translate-x-0.5"
            >
              <line x1="5" y1="12" x2="18" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
            <span>{item.title}</span>
          </a>
        </li>
      ))}
    </ol>
    </Fragment>
    )}

    <!-- 3. Work Inquiry / Quick Newsletter Box -->
    <div class="mt-4 p-7 bg-card-bg border-2 border-dashed border-cloud-500 rounded-2xl shadow-sm flex flex-col gap-3" id="contact">
      <h3 class="text-lg font-bold text-page-text m-0">¿Hablamos de ingeniería? 📬</h3>
      <p class="text-sm text-text-muted leading-relaxed m-0">
        Disponible para resolver retos en sistemas concurrentes, telemetría IoT o infraestructura Linux.
      </p>
      
      <form onsubmit="event.preventDefault(); alert('¡Gracias por tu interés! Configura tu servicio de formularios (Formspree, Resend, etc.) aquí.');">
        <div class="flex items-center gap-2 bg-page border border-card-border rounded-lg p-1 pl-3 mt-2 focus-within:ring-2 focus-within:ring-primary">
          <input
            type="email"
            placeholder="Tu correo electrónico..."
            required
            class="flex-1 border-0 bg-transparent text-sm text-page-text outline-none"
            aria-label="Tu correo electrónico"
          />
          <button
            type="submit"
            class="flex items-center justify-center w-8 h-8 border-0 rounded-md bg-primary text-white cursor-pointer transition duration-200 hover:scale-105 hover:brightness-110"
            aria-label="Send message"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
        </div>
      </form>
    </div>
  </section>
</aside>

<script>
  function setupCategoryFiltering() {
    const group = document.getElementById('category-filter-group');
    if (!group) return;

    const buttons = group.querySelectorAll<HTMLButtonElement>('.category-chip');
    const cards = document.querySelectorAll<HTMLElement>('.josh-card');

    buttons.forEach(btn => {
      btn.addEventListener('click', () => {
        buttons.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        const filter = btn.getAttribute('data-filter');

        cards.forEach(card => {
          const category = card.getAttribute('data-category');
          if (filter === 'all' || category === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupCategoryFiltering();
  document.addEventListener('astro:after-swap', setupCategoryFiltering);
</script>

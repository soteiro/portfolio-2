---
// Footer.astro
import { portfolioData } from '../data/portfolio';

const currentYear = new Date().getFullYear();
const { pathname } = Astro.url;
---

<footer class="mt-16 border-t border-card-border bg-surface text-page-text">
  <div class="site-container py-12">
    <div class="grid grid-cols-1 md:grid-cols-[1.6fr_1fr_1fr] gap-10 pb-10 border-b border-card-border">
      <!-- Identidad -->
      <div class="flex flex-col gap-3 max-w-md">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 min-h-11 font-display text-lg font-extrabold tracking-tight text-page-text hover:text-primary transition-colors w-fit"
        >
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            class="text-primary shrink-0"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"></circle>
            <circle cx="12" cy="12" r="5" stroke="var(--color-secondary)" stroke-width="1.5"></circle>
            <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
          </svg>
          <span>{portfolioData.name.display}</span>
        </a>

        <p class="text-sm leading-relaxed text-text-muted m-0">
          Ingeniería de software enfocada en sistemas backend en Go, infraestructura Linux y telemetría IoT en producción.
        </p>

        <p class="inline-flex items-center gap-2 text-xs font-medium text-text-muted m-0">
          <span class="w-2 h-2 rounded-full bg-status-ok shrink-0" aria-hidden="true"></span>
          <span>Valdivia, CL (UTC-3/-4) · Remoto y proyectos</span>
        </p>
      </div>

      <!-- Navegación -->
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-sm font-bold text-page-text m-0">
          Navegación
        </h2>
        <ul class="flex flex-col gap-0.5 list-none p-0 m-0">
          <li>
            <a
              href="/"
              aria-current={pathname === '/' ? 'page' : undefined}
              class="inline-flex items-center min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
            >
              Inicio
            </a>
          </li>
          <li>
            <a
              href="/projects"
              aria-current={pathname.startsWith('/projects') ? 'page' : undefined}
              class="inline-flex items-center min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
            >
              Proyectos
            </a>
          </li>
          <li>
            <a
              href="/blog"
              aria-current={pathname.startsWith('/blog') ? 'page' : undefined}
              class="inline-flex items-center min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
            >
              Blog
            </a>
          </li>
          <li>
            <a
              href="/about"
              aria-current={pathname === '/about' ? 'page' : undefined}
              class="inline-flex items-center min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
            >
              Sobre mí
            </a>
          </li>
        </ul>
      </div>

      <!-- Canales directos -->
      <div class="flex flex-col gap-3">
        <h2 class="font-display text-sm font-bold text-page-text m-0">
          Canales
        </h2>
        <ul class="flex flex-col gap-0.5 list-none p-0 m-0">
          <li>
            <a
              href={`mailto:${portfolioData.social.email}`}
              class="inline-flex items-center min-h-11 text-sm font-mono text-primary hover:underline"
            >
              {portfolioData.social.email}
            </a>
          </li>
          {portfolioData.social.linkedin && (
            <li>
              <a
                href={portfolioData.social.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
              >
                <span>LinkedIn<span class="sr-only"> (abre en una nueva pestaña)</span></span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </li>
          )}
          {portfolioData.social.github && (
            <li>
              <a
                href={portfolioData.social.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
              >
                <span>GitHub<span class="sr-only"> (abre en una nueva pestaña)</span></span>
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            </li>
          )}
          {portfolioData.social.rss && (
            <li>
              <a
                href={portfolioData.social.rss}
                class="inline-flex items-center gap-1.5 min-h-11 text-sm text-text-muted hover:text-primary transition-colors"
              >
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 11a9 9 0 0 1 9 9"></path>
                  <path d="M4 4a16 16 0 0 1 16 16"></path>
                  <circle cx="5" cy="19" r="1"></circle>
                </svg>
                <span>Feed RSS</span>
              </a>
            </li>
          )}
        </ul>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-4 pt-6 text-xs text-text-muted">
      <p class="m-0">
        © {currentYear} {portfolioData.name.display} · Valdivia, Chile.
      </p>
      <p class="m-0">
        soteiro.dev · Astro + Cloudflare Workers
      </p>
    </div>
  </div>
</footer>

---
/**
 * Todo el `<head>` relacionado con SEO: título, canonical, Open Graph,
 * Twitter Card, hreflang, robots y JSON-LD.
 *
 * El canonical se calcula siempre desde `Astro.site`, nunca desde el host de
 * la petición: así una visita a un dominio antiguo o a la URL de Cloudflare
 * sigue apuntando a soteiro.dev y no genera contenido duplicado.
 */
import {
  SITE_NAME,
  TITLE_SEPARATOR,
  LOCALE_TAGS,
  LOCALES,
  DEFAULT_LOCALE,
  VERIFICATION,
  type Locale,
} from '../config/site';
import { absoluteUrl, ogImageUrl } from '../lib/seo';
import { canonicalPath, localizePath, getLocale } from '../lib/i18n';

interface Props {
  title: string;
  description: string;
  /** Ruta canónica. Por defecto, la de la página actual normalizada. */
  canonical?: string;
  /** URL absoluta de la imagen social. Por defecto, la generada para la ruta. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article' | 'profile';
  /** `false` cuando el título ya está completo y no debe llevar sufijo. */
  suffix?: boolean;
  noindex?: boolean;
  publishedTime?: Date;
  modifiedTime?: Date;
  section?: string;
  tags?: string[];
  /** JSON-LD ya serializado (ver `jsonLdGraph`). */
  jsonLd?: string;
  /**
   * Rutas equivalentes en otros idiomas. Solo se emite `hreflang` cuando hay
   * al menos una traducción real: apuntar a una URL que todavía no existe es
   * peor que no declarar nada.
   */
  translations?: Partial<Record<Locale, string>>;
}

const {
  title,
  description,
  canonical,
  image,
  imageAlt,
  type = 'website',
  suffix = true,
  noindex = false,
  publishedTime,
  modifiedTime,
  section,
  tags = [],
  jsonLd,
  translations,
} = Astro.props;

const locale = getLocale(Astro.url);
const path = canonicalPath(canonical ?? Astro.url.pathname);
const canonicalUrl = absoluteUrl(path);

const fullTitle = suffix ? `${title}${TITLE_SEPARATOR}${SITE_NAME}` : title;

// La ruta sin barra inicial es también la clave del PNG generado:
// `/blog/mi-post` → `/og/blog/mi-post.png`.
const socialImage = image ?? ogImageUrl(path);

const hasTranslations = Boolean(translations && Object.keys(translations).length > 0);
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalUrl} />

<meta
  name="robots"
  content={noindex
    ? 'noindex, nofollow'
    : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
/>

{/* Open Graph */}
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:locale" content={LOCALE_TAGS[locale].replace('-', '_')} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:alt" content={imageAlt ?? fullTitle} />

{type === 'article' && publishedTime && (
  <meta property="article:published_time" content={publishedTime.toISOString()} />
)}
{type === 'article' && (
  <meta
    property="article:modified_time"
    content={(modifiedTime ?? publishedTime ?? new Date()).toISOString()}
  />
)}
{type === 'article' && <meta property="article:author" content={SITE_NAME} />}
{type === 'article' && section && <meta property="article:section" content={section} />}
{type === 'article' && tags.map((tag) => <meta property="article:tag" content={tag} />)}

{/* Twitter / X */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />
<meta name="twitter:image:alt" content={imageAlt ?? fullTitle} />

{/* hreflang: solo con traducciones publicadas */}
{hasTranslations && (
  <>
    {LOCALES.filter((l) => translations?.[l]).map((l) => (
      <link
        rel="alternate"
        hreflang={LOCALE_TAGS[l]}
        href={absoluteUrl(translations![l]!)}
      />
    ))}
    <link
      rel="alternate"
      hreflang="x-default"
      href={absoluteUrl(translations?.[DEFAULT_LOCALE] ?? localizePath(path, DEFAULT_LOCALE))}
    />
  </>
)}

<link rel="alternate" type="application/rss+xml" title={`RSS — ${SITE_NAME}`} href={absoluteUrl('/rss.xml')} />
<link rel="sitemap" type="application/xml" href={absoluteUrl('/sitemap-index.xml')} />

{VERIFICATION.google && <meta name="google-site-verification" content={VERIFICATION.google} />}
{VERIFICATION.bing && <meta name="msvalidate.01" content={VERIFICATION.bing} />}

{jsonLd && <script type="application/ld+json" is:inline set:html={jsonLd} />}

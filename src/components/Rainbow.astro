---
// Rainbow.astro
// Josh W. Comeau's iconic interactive Rainbow:
// 1. Enters with a staggered spring animation across all color bands
// 2. Rests in a vibrant semicircle arch
// 3. Reacts magnetically to the cursor/touch pointer with fluid spring physics
---

<div class="relative w-full max-w-[460px] max-sm:max-w-[340px] h-[260px] max-sm:h-[200px] mx-auto flex items-end justify-center select-none touch-none" id="rainbow-wrapper">
  <!-- Interactive Canvas for the Rainbow bands -->
  <canvas id="rainbow-canvas" class="absolute inset-0 w-full h-full z-2 cursor-crosshair" aria-label="Arcoíris interactivo animado"></canvas>

  <!-- Left and right marshmallow cloud anchors -->
  <div class="hidden absolute -bottom-0.5 z-3 pointer-events-none drop-shadow-[0_4px_8px_rgba(0,0,0,0.06)] transition-transform duration-300 left-2 max-sm:left-0.5 w-90px max-sm:w-72px md:block" aria-hidden="true">
    <svg viewBox="0 0 100 60" class="w-full h-auto ">
      <path d="M10 50 C5 50 0 45 0 38 C0 30 6 25 14 25 C16 12 28 5 42 5 C56 5 66 14 70 24 C75 22 80 23 84 26 C93 28 100 36 100 45 C100 52 94 58 86 58 L10 58 Z" fill="var(--color-cloud-300)" />
      <path d="M14 50 C10 50 6 46 6 40 C6 33 11 28 18 28 C20 17 30 10 42 10 C54 10 63 18 66 27 C70 25 75 26 78 29 C86 31 92 38 92 46 C92 51 87 56 80 56 L14 56 Z" fill="var(--color-background)" />
    </svg>
  </div>

  <div class="hidden absolute -bottom-0.5 z-3 pointer-events-none drop-shadow-[0_4px_8px_rgba(0,0,0,0.06)] transition-transform duration-300 right-2 max-sm:right-0.5 w-90px max-sm:w-72px -scale-x-100 md:block md:transition-all" aria-hidden="true">
    <svg viewBox="0 0 100 60" class="w-full h-auto">
      <path d="M10 50 C5 50 0 45 0 38 C0 30 6 25 14 25 C16 12 28 5 42 5 C56 5 66 14 70 24 C75 22 80 23 84 26 C93 28 100 36 100 45 C100 52 94 58 86 58 L10 58 Z" fill="var(--color-cloud-300)" />
      <path d="M14 50 C10 50 6 46 6 40 C6 33 11 28 18 28 C20 17 30 10 42 10 C54 10 63 18 66 27 C70 25 75 26 78 29 C86 31 92 38 92 46 C92 51 87 56 80 56 L14 56 Z" fill="var(--color-background)" />
    </svg>
  </div>

  <!-- Whimsical hint badge -->
  <!-- <div class="rainbow-hint absolute -top-2.5 z-5 text-xs font-bold text-primary bg-page px-3 py-1 rounded-full border border-dashed border-primary shadow-md pointer-events-none opacity-90 transition duration-500 animate-[bounceHint_3s_ease-in-out_infinite] [&.hidden]:opacity-0 [&.hidden]:scale-80" id="rainbow-hint" aria-hidden="true">
    <span>✨ ¡Pasa el puntero por el arcoíris!</span>
  </div> -->
</div>

<script>
  // Rainbow Interactive Animation Engine
  // Each band is a dashed arc. A dash keeps its place on the arch and only
  // changes orientation: it swings to point at the cursor (iron-filings
  // style), stretching longer and thinner the closer the pointer gets.
  interface Dash {
    cx: number;        // fixed centre on the arch
    cy: number;
    arcAngle: number;  // position along the arch (PI = left, 0 = right)
    baseAngle: number; // tangent orientation, the resting pose
    angle: number;     // current orientation
    vAngle: number;    // angular velocity, for the spring
    length: number;
    width: number;
  }

  interface Band {
    color: string;
    thickness: number;
    dashes: Dash[];
    enterProgress: number; // 0 to 1
    enterDelay: number;    // seconds
  }

  // Dash shape, in multiples of a band's thickness
  const REST_LENGTH = 0.35; // resting length: a round dot
  const STRETCH = 2.0;      // extra length when fully aligned to the pointer
  const DASH_STEP = 2.2;    // spacing between dash centres along the arch

  class WhimsicalRainbow {
    canvas: HTMLCanvasElement;
    ctx: CanvasRenderingContext2D;
    wrapper: HTMLElement;
    hint: HTMLElement | null;

    bands: Band[] = [];
    width = 200;
    height = 200;
    centerX = 100;
    centerY = 225;

    // Mouse state
    mouseX = -1000;
    mouseY = -1000;
    isHovering = false;
    animFrameId = 0;
    startTime = 0;
    hasEntered = false;

    // Audio notes (pentatonic scale for rainbow strings)
    noteFrequencies = [523.25, 587.33, 659.25, 783.99, 880.0, 1046.5]; // C5, D5, E5, G5, A5, C6
    lastAudioTime = 0;
    audioCtx: AudioContext | null = null;

    constructor(canvas: HTMLCanvasElement, wrapper: HTMLElement) {
      this.canvas = canvas;
      this.wrapper = wrapper;
      this.ctx = canvas.getContext('2d')!;
      this.hint = document.getElementById('rainbow-hint');

      this.handleResize();
      this.bindEvents();

      this.startTime = performance.now();
      this.loop = this.loop.bind(this);
      this.animFrameId = requestAnimationFrame(this.loop);
    }

    initBands() {
      // Josh's signature neon-pastel rainbow colors (from outer arch to inner):
      // Purple, Blue, Green, Yellow, Orange, Red
      const colors = [
        '#9757D7', // Electric Purple (outermost)
        '#38B6FF', // Sky Blue
        '#35E385', // Mint Green
        '#FFD13B', // Sunny Yellow
        '#FF9233', // Vivid Orange
        '#FF5964'  // Coral Red (innermost)
      ];

      const baseRadius = Math.min(this.width * 0.44, 185);
      const bandThickness = Math.max(9, Math.min(13, this.width / 34));
      const spacing = bandThickness + 3;

      this.bands = colors.map((color, bandIndex) => {
        const radius = baseRadius - bandIndex * spacing;
        // At rest a dash is barely longer than it is thick: a round dot.
        const dashLength = bandThickness * REST_LENGTH;
        // Constant gap between dashes, so inner arcs simply hold fewer of them
        const step = bandThickness * DASH_STEP;
        const count = Math.max(6, Math.round((Math.PI * radius) / step));
        const dashes: Dash[] = [];

        for (let i = 0; i < count; i++) {
          // Inset by half a step so no dash straddles the cloud anchors
          const arcAngle = Math.PI - (Math.PI * (i + 0.5)) / count;
          // Tangent to the arch. Negated because the canvas Y axis points down.
          const tangent = -(arcAngle + Math.PI / 2);

          dashes.push({
            cx: this.centerX + Math.cos(arcAngle) * radius,
            cy: this.centerY - Math.sin(arcAngle) * radius,
            arcAngle,
            baseAngle: tangent,
            angle: tangent,
            vAngle: 0,
            length: dashLength,
            width: bandThickness
          });
        }

        return {
          color,
          thickness: bandThickness,
          dashes,
          enterProgress: 0,
          enterDelay: bandIndex * 0.25 // Staggered enter
        };
      });
    }

    handleResize() {
      const rect = this.wrapper.getBoundingClientRect();
      const dpr = window.devicePixelRatio || 1;

      this.width = rect.width;
      this.height = rect.height;
      this.centerX = this.width / 2;
      this.centerY = this.height - 15;

      this.canvas.width = this.width * dpr;
      this.canvas.height = this.height * dpr;
      this.ctx.resetTransform?.();
      this.ctx.scale(dpr, dpr);

      // Re-anchor the dashes to the new size
      this.initBands();
    }

    bindEvents() {
      window.addEventListener('resize', () => this.handleResize());

      const onPointerMove = (clientX: number, clientY: number) => {
        const rect = this.canvas.getBoundingClientRect();
        this.mouseX = clientX - rect.left;
        this.mouseY = clientY - rect.top;
        this.isHovering = true;

        if (this.hint && !this.hint.classList.contains('hidden')) {
          this.hint.classList.add('hidden');
        }

        // Trigger gentle sound when cursor moves across bands
        this.triggerPlayfulSound();
      };

      this.canvas.addEventListener('mousemove', (e) => {
        onPointerMove(e.clientX, e.clientY);
      });

      this.canvas.addEventListener('mouseleave', () => {
        this.isHovering = false;
        this.mouseX = -1000;
        this.mouseY = -1000;
      });

      // Touch support
      this.canvas.addEventListener('touchmove', (e) => {
        if (e.touches.length > 0) {
          onPointerMove(e.touches[0].clientX, e.touches[0].clientY);
        }
      }, { passive: true });

      this.canvas.addEventListener('touchend', () => {
        this.isHovering = false;
        this.mouseX = -1000;
        this.mouseY = -1000;
      });
    }

    triggerPlayfulSound() {
      const now = performance.now();
      if (now - this.lastAudioTime < 90) return;

      // Check if sound is enabled
      const soundEnabled = localStorage.getItem('sound-enabled') !== 'false';
      if (!soundEnabled) return;

      try {
        const AudioCtx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!AudioCtx) return;

        // One context for the whole page, created on first note
        if (!this.audioCtx) this.audioCtx = new AudioCtx();
        const audioCtx = this.audioCtx;
        if (audioCtx.state === 'suspended') audioCtx.resume();

        // Pick frequency based on mouse position
        const noteIndex = Math.floor(Math.random() * this.noteFrequencies.length);
        const freq = this.noteFrequencies[noteIndex];

        const osc = audioCtx.createOscillator();
        const gain = audioCtx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(freq, audioCtx.currentTime);

        gain.gain.setValueAtTime(0.04, audioCtx.currentTime);
        gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.12);

        osc.connect(gain);
        gain.connect(audioCtx.destination);

        osc.start();
        osc.stop(audioCtx.currentTime + 0.12);
        this.lastAudioTime = now;
      } catch (e) {}
    }

    loop(timestamp: number) {
      const elapsed = (timestamp - this.startTime) / 1000;
      this.ctx.clearRect(0, 0, this.width, this.height);

      let allEntered = true;

      // Angular spring: how eagerly a dash swings to its target orientation
      const stiffness = 0.18;
      const damping = 0.72;
      const influenceRadius = Math.max(90, this.width * 0.32);

      this.ctx.lineCap = 'round';

      this.bands.forEach((band) => {
        // 1. Enter animation: dashes fan in left to right, staggered per band
        if (elapsed > band.enterDelay) {
          const t = Math.min(1, (elapsed - band.enterDelay) / 0.85);
          band.enterProgress = 1 - Math.pow(1 - t, 3);
        } else {
          band.enterProgress = 0;
        }

        if (band.enterProgress < 0.999) {
          allEntered = false;
        }

        const visibleCount = Math.round(band.dashes.length * band.enterProgress);
        const restLength = band.thickness * REST_LENGTH;

        for (let i = 0; i < visibleCount; i++) {
          const dash = band.dashes[i];

          // 2. How strongly this dash feels the pointer: 0 at rest, 1 fully aligned
          let pull = 0;
          let targetAngle = dash.baseAngle;

          if (this.isHovering && this.hasEntered) {
            const dx = this.mouseX - dash.cx;
            const dy = this.mouseY - dash.cy;
            const dist = Math.hypot(dx, dy);

            if (dist < influenceRadius) {
              pull = Math.pow(1 - dist / influenceRadius, 1.6);
              targetAngle = Math.atan2(dy, dx);
            }
          } else if (this.hasEntered) {
            // Gentle breathing wobble while the pointer is away
            targetAngle += Math.sin(elapsed * 1.6 + dash.arcAngle * 2.5) * 0.06;
          }

          // 3. Spring the orientation. A dash is symmetric, so the shortest
          // path is taken modulo PI: it never spins a needless half turn.
          let diff = targetAngle - dash.angle;
          diff = (((diff + Math.PI / 2) % Math.PI) + Math.PI) % Math.PI - Math.PI / 2;

          dash.vAngle = (dash.vAngle + diff * stiffness) * damping;
          dash.angle += dash.vAngle;

          // 4. An aligned dash stretches out and thins down
          const targetLength = restLength + band.thickness * STRETCH * pull;
          const targetWidth = band.thickness * (1 - pull * 0.58);
          dash.length += (targetLength - dash.length) * 0.2;
          dash.width += (targetWidth - dash.width) * 0.2;

          // 5. Draw it as a straight stroke centred on its fixed spot
          const half = dash.length / 2;
          const ox = Math.cos(dash.angle) * half;
          const oy = Math.sin(dash.angle) * half;

          this.ctx.beginPath();
          this.ctx.moveTo(dash.cx - ox, dash.cy - oy);
          this.ctx.lineTo(dash.cx + ox, dash.cy + oy);
          this.ctx.strokeStyle = band.color;
          this.ctx.lineWidth = dash.width;
          this.ctx.stroke();
        }
      });

      if (allEntered) {
        this.hasEntered = true;
      }

      this.animFrameId = requestAnimationFrame(this.loop);
    }
  }

  function setupRainbow() {
    const canvas = document.getElementById('rainbow-canvas') as HTMLCanvasElement | null;
    const wrapper = document.getElementById('rainbow-wrapper');
    if (!canvas || !wrapper) return;

    new WhimsicalRainbow(canvas, wrapper);
  }

  setupRainbow();
  document.addEventListener('astro:after-swap', setupRainbow);
</script>
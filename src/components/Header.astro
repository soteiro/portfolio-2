---
// Header.astro
import ThemeToggle from './ThemeToggle.astro';
import { portfolioData } from '../data/portfolio';

const { pathname } = Astro.url;

const navLinks = [
  { href: '/', label: 'Inicio', active: pathname === '/' },
  { href: '/projects', label: 'Proyectos', active: pathname.startsWith('/projects') },
  { href: '/blog', label: 'Blog', active: pathname.startsWith('/blog') },
  { href: '/about', label: 'Sobre mí', active: pathname === '/about' },
];
---

<header class="sticky top-0 z-50 w-full border-b border-card-border bg-[var(--color-header-bg)] backdrop-blur-md">
  <div class="site-container">
    <div class="flex items-center justify-between gap-4 h-[4.5rem]">
      <!-- Marca y disponibilidad -->
      <div class="flex items-center gap-4 min-w-0">
        <a
          href="/"
          class="inline-flex items-center gap-2.5 font-display text-lg sm:text-xl font-extrabold tracking-tight text-page-text no-underline transition-colors duration-200 hover:text-primary shrink-0"
          aria-label={`${portfolioData.name.display} — Inicio`}
        >
          <svg
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            class="text-primary shrink-0"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="9.5" stroke="currentColor" stroke-width="1.5" stroke-dasharray="4 3"></circle>
            <circle cx="12" cy="12" r="5" stroke="var(--color-secondary)" stroke-width="1.5"></circle>
            <circle cx="12" cy="12" r="2" fill="currentColor"></circle>
          </svg>
          <span>{portfolioData.name.display}</span>
        </a>

        <span
          class="hidden lg:inline-flex items-center gap-2 pl-4 border-l border-card-border text-xs font-medium text-text-muted truncate"
        >
          <span class="w-2 h-2 rounded-full bg-status-ok shrink-0" aria-hidden="true"></span>
          <span>Valdivia, CL · Disponible remoto</span>
        </span>
      </div>

      <!-- Navegación principal (escritorio) -->
      <nav class="hidden md:flex items-center" aria-label="Navegación principal">
        <ul class="flex items-center gap-1 list-none p-0 m-0">
          {navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class={`inline-flex items-center min-h-11 px-3.5 text-[0.9375rem] font-medium rounded border transition-colors duration-150 ${
                  item.active
                    ? 'text-primary border-border-strong bg-surface'
                    : 'text-text-muted border-transparent hover:text-page-text hover:bg-surface'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Acciones -->
      <div class="flex items-center gap-2 shrink-0">
        {portfolioData.social.github && (
          <a
            href={portfolioData.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center w-11 h-11 rounded border border-card-border bg-surface text-page-text transition-colors duration-150 hover:border-primary hover:text-primary"
            aria-label="Perfil de GitHub de Diego Soto"
            title="GitHub"
          >
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )}

        <ThemeToggle />

        <button
          id="mobile-menu-btn"
          type="button"
          class="inline-flex md:hidden items-center justify-center w-11 h-11 p-0 border border-card-border bg-surface text-page-text cursor-pointer rounded hover:border-primary hover:text-primary transition-colors duration-150"
          aria-label="Abrir menú de navegación"
          aria-expanded="false"
          aria-controls="mobile-drawer"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="4" y1="7" x2="20" y2="7"></line>
            <line x1="4" y1="12" x2="20" y2="12"></line>
            <line x1="4" y1="17" x2="20" y2="17"></line>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Backdrop y menú móvil con trampa de foco -->
  <div
    id="mobile-drawer-backdrop"
    class="md:hidden fixed inset-0 top-[4.5rem] z-40 bg-black/55 backdrop-blur-[2px] [[hidden]]:hidden"
    hidden
    aria-hidden="true"
  ></div>

  <div
    id="mobile-drawer"
    role="dialog"
    aria-modal="true"
    aria-label="Menú de navegación"
    class="drawer-enter md:hidden fixed top-[5rem] left-4 right-4 z-50 bg-surface border border-border-strong rounded-md shadow-2xl overflow-hidden [[hidden]]:hidden"
    hidden
  >
    <div class="p-5 flex flex-col gap-4">
      <div class="flex items-center justify-between pb-3 border-b border-card-border">
        <span class="inline-flex items-center gap-2 text-xs font-medium text-text-muted">
          <span class="w-2 h-2 rounded-full bg-status-ok shrink-0" aria-hidden="true"></span>
          <span>Valdivia, CL · Disponible remoto</span>
        </span>
        <button
          id="mobile-menu-close"
          type="button"
          class="inline-flex items-center justify-center w-11 h-11 rounded border border-card-border text-text-muted hover:text-page-text hover:border-primary cursor-pointer bg-transparent"
          aria-label="Cerrar menú de navegación"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>

      <nav aria-label="Navegación móvil">
        <ul class="list-none p-0 m-0 flex flex-col gap-1.5">
          {navLinks.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={item.active ? 'page' : undefined}
                class={`flex items-center min-h-11 px-3.5 text-base font-medium rounded border transition-colors ${
                  item.active
                    ? 'text-primary border-border-strong bg-surface-elevated'
                    : 'text-page-text border-transparent hover:bg-surface-elevated'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="flex flex-wrap items-center gap-3 pt-4 border-t border-card-border">
        <a href={`mailto:${portfolioData.social.email}`} class="telemetry-btn-primary flex-1 text-sm">
          Escribir correo
        </a>
        {portfolioData.social.linkedin && (
          <a
            href={portfolioData.social.linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="telemetry-btn-secondary text-sm"
          >
            <span>LinkedIn</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M7 17 17 7"></path>
              <path d="M7 7h10v10"></path>
            </svg>
          </a>
        )}
      </div>
    </div>
  </div>
</header>

<script>
  let mobileMenuController: AbortController | null = null;

  function setupMobileMenu() {
    mobileMenuController?.abort();
    mobileMenuController = new AbortController();
    const { signal } = mobileMenuController;

    const btn = document.getElementById('mobile-menu-btn');
    const closeBtn = document.getElementById('mobile-menu-close');
    const drawer = document.getElementById('mobile-drawer');
    const backdrop = document.getElementById('mobile-drawer-backdrop');
    if (!btn || !drawer) return;

    const getFocusable = () =>
      Array.from(
        drawer.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      );

    const setOpen = (open: boolean, returnFocus = false) => {
      if (open) {
        drawer.removeAttribute('hidden');
        backdrop?.removeAttribute('hidden');
        closeBtn?.focus();
      } else {
        drawer.setAttribute('hidden', '');
        backdrop?.setAttribute('hidden', '');
      }
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
      if (!open && returnFocus) {
        btn.focus();
      }
    };

    btn.addEventListener('click', () => setOpen(drawer.hasAttribute('hidden')), { signal });
    closeBtn?.addEventListener('click', () => setOpen(false, true), { signal });
    backdrop?.addEventListener('click', () => setOpen(false, true), { signal });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false), { signal });
    });

    document.addEventListener(
      'keydown',
      (event) => {
        if (drawer.hasAttribute('hidden')) return;

        if (event.key === 'Escape') {
          event.preventDefault();
          setOpen(false, true);
          return;
        }

        if (event.key === 'Tab') {
          const focusables = getFocusable();
          if (focusables.length === 0) return;
          const first = focusables[0];
          const last = focusables[focusables.length - 1];

          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      },
      { signal }
    );

    const desktopQuery = window.matchMedia('(min-width: 768px)');
    desktopQuery.addEventListener(
      'change',
      (event) => {
        if (event.matches && !drawer.hasAttribute('hidden')) {
          setOpen(false);
        }
      },
      { signal }
    );
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

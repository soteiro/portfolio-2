---

import ThemeToggle from './ThemeToggle.astro';
import SoundToggle from './SoundToggle.astro';
import { portfolioData } from '../data/portfolio';

const { pathname } = Astro.url;
---

<div class="sticky top-0 z-50 w-full transition-[background] duration-300">
  <!-- Top blur blocker effect from Josh's site -->
  <div class="absolute inset-0 backdrop-blur-md bg-gradient-b from-white/75 dark:from-[#0d0f12]/75 to-transparent pointer-events-none mask-[linear-gradient(to_bottom,black_70%,transparent_100%)]"></div>

  <div class="max-w-1100px mx-auto px-6">
    <header class="flex items-center justify-between h-20 relative z-10">
      <!-- Signature Animated Logo -->
      <a class="inline-flex items-baseline text-[1.625rem] font-medium tracking-[-0.0625rem] text-primary no-underline transition-transform duration-200 hover:scale-[1.03]" href="/" aria-label={`${portfolioData.name.display} Homepage`}>
        <span class="inline-block">{portfolioData.name.first.split(" ")[0]}</span>
        <span class="inline-block relative w-1.125rem mx-1px text-secondary">
          <svg width="14" height="12" viewBox="0 0 14 12" fill="none" class="absolute left-2px -top-1px stroke-secondary animate-[drawSquiggle_0.6s_cubic-bezier(0.27,0.22,0.44,1.03)_both]">
            <path
              d="M1.83685 4.19021C2.50472 5.35898 3.23081 6.5572 3.80331 7.77375C4.05248 8.30325 4.35843 9.36185 4.81149 9.75018C5.73454 10.5414 6.29678 10.273 6.76796 9.06143C7.13194 8.12547 7.20283 7.08915 7.54655 6.12672C7.91111 5.10596 9.23909 6.70274 9.78252 7.06503C10.3171 7.42139 13.574 9.528 12.8869 7.60406C12.6687 6.99301 12.6107 6.33922 12.4777 5.70748C12.3451 5.07774 12.1099 4.28137 12.0784 3.65119C12.0399 2.88207 11.719 2.12838 11.719 1.3154"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <svg width="9" height="10" viewBox="0 0 9 10" fill="none" class="absolute left-6px bottom-1px stroke-primary animate-[drawSquiggle_0.5s_0.2s_cubic-bezier(0.27,0.22,0.44,1.03)_both]">
            <path
              d="M1 9C2.23995 7.12464 3.87268 5.18927 4.17593 2.59926C4.22017 2.22137 4.11111 0.731563 4.11111 1.04233C4.11111 1.49132 4.41831 2.03152 4.55761 2.40705C4.98522 3.55977 5.31447 4.69324 5.92593 5.70352C6.43274 6.54092 7.08081 7.96204 8 7.96204"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            ></path>
          </svg>
          <span class="opacity-0 select-none">{portfolioData.name.initial}</span>
        </span>
        <span class="inline-block">{portfolioData.name.last}</span>
      </a>

      <!-- Navigation Links -->
      <nav class="hidden md:flex items-center" aria-label="Main Navigation">
        <ul class="flex items-center gap-2 list-none p-0 m-0">
          <li>
            <a class={`flex items-center h-11 px-4 text-base rounded-md transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:-translate-y-0.5 ${pathname === '/' ? 'font-medium text-primary' : 'font-normal text-page-text'}`} href="/#projects">Projects</a>
          </li>
          <li>
            <a class={`flex items-center h-11 px-4 text-base rounded-md transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:-translate-y-0.5 ${pathname.startsWith('/blog') ? 'font-medium text-primary' : 'font-normal text-page-text'}`} href="/blog">Blog</a>
          </li>
          <li>
            <a class={`flex items-center h-11 px-4 text-base rounded-md transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:-translate-y-0.5 ${pathname === '/about' ? 'font-medium text-primary' : 'font-normal text-page-text'}`} href="/about">About</a>
          </li>
          <li>
            <a class="flex items-center h-11 px-4 text-base font-normal text-page-text rounded-md transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:-translate-y-0.5" href="/#skills">Skills</a>
          </li>
          <li>
            <a class="flex items-center h-11 px-4 text-base font-normal text-page-text rounded-md transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:-translate-y-0.5" href="/#contact">Contact</a>
          </li>
        </ul>
      </nav>

      <!-- Action Buttons -->
      <div class="flex items-center gap-3">
        <!-- Sound Effect Toggle -->
        <SoundToggle />

        <!-- Theme Mode Toggle -->
        <ThemeToggle />

        <!-- GitHub Profile -->
        {portfolioData.social.github && (
          <a
            href={portfolioData.social.github}
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center justify-center w-9 h-9 rounded-full text-page-text transition duration-200 hover:text-primary hover:bg-cloud-300 dark:hover:bg-cloud-400 hover:scale-110"
            aria-label="GitHub Profile"
            title="GitHub"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"></path>
              <path d="M9 18c-4.51 2-5-2-7-2"></path>
            </svg>
          </a>
        )}

        <!-- Mobile Menu Toggle Button -->
        <button id="mobile-menu-btn" class="flex md:hidden items-center justify-center w-9 h-9 p-0 border-0 bg-transparent text-page-text cursor-pointer rounded-md" aria-label="Toggle navigation menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
        </button>
      </div>
    </header>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-drawer" class="mobile-drawer fixed top-20 left-4 right-4 bg-card-bg border border-card-border rounded-2xl shadow-2xl overflow-hidden [[hidden]]:hidden animate-[drawerEnter_0.3s_cubic-bezier(0.17,0.67,0.39,1.2)]" hidden>
    <div class="p-6 flex flex-col gap-6">
      <nav>
        <ul class="list-none p-0 m-0 flex flex-col gap-2">
          <li><a href="/#projects" class="block px-4 py-3 text-lg font-medium text-page-text rounded-lg hover:bg-cloud-300 hover:text-primary transition-colors">Projects</a></li>
          <li><a href="/blog" class="block px-4 py-3 text-lg font-medium text-page-text rounded-lg hover:bg-cloud-300 hover:text-primary transition-colors">Blog</a></li>
          <li><a href="/about" class="block px-4 py-3 text-lg font-medium text-page-text rounded-lg hover:bg-cloud-300 hover:text-primary transition-colors">About</a></li>
          <li><a href="/#skills" class="block px-4 py-3 text-lg font-medium text-page-text rounded-lg hover:bg-cloud-300 hover:text-primary transition-colors">Skills & Stack</a></li>
          <li><a href="/#contact" class="block px-4 py-3 text-lg font-medium text-page-text rounded-lg hover:bg-cloud-300 hover:text-primary transition-colors">Contact</a></li>
        </ul>
      </nav>
      <div class="flex gap-4 pt-4 border-t border-card-border">
        {portfolioData.social.github && <a href={portfolioData.social.github} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">GitHub</a>}
        {portfolioData.social.linkedin && <a href={portfolioData.social.linkedin} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">LinkedIn</a>}
        <!-- {portfolioData.social.bluesky && <a href={portfolioData.social.bluesky} target="_blank" rel="noopener noreferrer" class="text-primary hover:underline font-medium">BlueSky</a>} -->
      </div>
    </div>
  </div>
</div>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-btn');
    const drawer = document.getElementById('mobile-drawer');
    if (!btn || !drawer) return;

    btn.addEventListener('click', () => {
      const isHidden = drawer.hasAttribute('hidden');
      if (isHidden) {
        drawer.removeAttribute('hidden');
      } else {
        drawer.setAttribute('hidden', '');
      }
    });

    // Close on navigation click
    drawer.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        drawer.setAttribute('hidden', '');
      });
    });
  }

  setupMobileMenu();
  document.addEventListener('astro:after-swap', setupMobileMenu);
</script>

---
// Callout.astro — Bloque de nota técnica con borde uniforme 1px e icono SVG
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'quote';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const accentClass = {
  info: 'text-secondary',
  tip: 'text-primary',
  warning: 'text-energy',
  quote: 'text-ring-text',
}[type];
---

<aside class="flex items-start gap-4 p-5 sm:p-6 my-6 rounded-md bg-surface border border-border-strong">
  <div class={`shrink-0 mt-0.5 ${accentClass}`} aria-hidden="true">
    {type === 'tip' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="m9 12 2 2 4-4"></path>
      </svg>
    )}
    {type === 'warning' && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path>
        <path d="M12 9v4"></path>
        <path d="M12 17h.01"></path>
      </svg>
    )}
    {(type === 'info' || type === 'quote') && (
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="9"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
    )}
  </div>
  <div class="flex-1 flex flex-col gap-1.5 min-w-0">
    {title && <strong class="font-display text-base font-bold text-page-text">{title}</strong>}
    <div class="text-[0.9375rem] leading-relaxed text-text-muted">
      <slot />
    </div>
  </div>
</aside>

---
// Callout.astro
// Josh W. Comeau signature whimsical callout block (info, tip, warning)
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'quote';
  title?: string;
}

const { type = 'info', title } = Astro.props;

const icons = {
  info: '💡',
  tip: '✨',
  warning: '⚠️',
  quote: '💬'
};

const typeClasses = {
  info: 'border-l-primary bg-info-100 dark:bg-info-200',
  tip: 'border-l-success-500 bg-success-100 dark:bg-success-100',
  warning: 'border-l-warning-500 bg-warning-100 dark:bg-warning-100',
  quote: 'border-l-secondary bg-cloud-300 dark:bg-cloud-400',
};
---

<aside class={`flex gap-4 p-5 md:p-6 my-6 rounded-xl relative border-l-4 ${typeClasses[type]}`}>
  <div class="text-2xl leading-none select-none" aria-hidden="true">{icons[type]}</div>
  <div class="flex-1 flex flex-col gap-1.5">
    {title && <strong class="text-base font-bold text-page-text">{title}</strong>}
    <div class="text-[0.9375rem] leading-relaxed text-page-text">
      <slot />
    </div>
  </div>
</aside>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { absoluteUrl, breadcrumbSchema, ogImageUrl, projectSchema } from '../../lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content } = await render(project);

const path = `/projects/${project.id}`;
const url = absoluteUrl(path);
const description = project.data.seoDescription ?? project.data.description ?? project.data.subtitle ?? '';
const image = project.data.ogImage ? absoluteUrl(project.data.ogImage) : ogImageUrl(path);

const jsonLd = JSON.stringify([
  projectSchema({
    title: project.data.title,
    description,
    url,
    image,
    tags: project.data.tags,
    year: project.data.year ?? undefined,
    demoUrl: project.data.demoUrl ?? undefined,
    githubUrl: project.data.githubUrl ?? undefined,
  }),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Proyectos', path: '/projects' },
    { name: project.data.title, path },
  ]),
]);
---

<Layout
  title={project.data.seoTitle ?? project.data.title}
  description={description}
  type="article"
  image={image}
  modifiedTime={project.data.updated ?? undefined}
  section={project.data.category}
  tags={project.data.tags}
  jsonLd={jsonLd}
>
  <div class="site-container max-w-[52rem] py-10 sm:py-14">
    <nav class="mb-8" aria-label="Migas de pan">
      <a
        href="/projects"
        class="inline-flex items-center gap-2 min-h-11 text-sm font-medium text-text-muted hover:text-primary transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a los proyectos</span>
      </a>
    </nav>

    <article>
      <header class="flex flex-col gap-4 mb-10 pb-8 border-b border-card-border">
        <h1 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold tracking-tight leading-tight text-page-text m-0">
          {project.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-2.5 text-xs text-text-muted">
          <span class="font-semibold text-secondary">{project.data.category}</span>
          {project.data.year && (
            <>
              <span>·</span>
              <span class="tabular-data">{project.data.year}</span>
            </>
          )}
          {project.data.featured && (
            <>
              <span>·</span>
              <span class="font-semibold text-primary">Destacado</span>
            </>
          )}
        </div>

        {project.data.subtitle && (
          <p class="text-base sm:text-lg text-text-muted leading-relaxed m-0">
            {project.data.subtitle}
          </p>
        )}

        {project.data.tags.length > 0 && (
          <p class="tabular-data text-xs text-text-muted pt-1 m-0">
            {project.data.tags.join(' · ')}
          </p>
        )}

        {(project.data.demoUrl || project.data.githubUrl) && (
          <div class="flex flex-wrap items-center gap-3 mt-3 pt-4 border-t border-card-border">
            {project.data.demoUrl && (
              <a
                href={project.data.demoUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="telemetry-btn-primary text-sm"
              >
                <span>Ver demo en vivo</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            )}
            {project.data.githubUrl && (
              <a
                href={project.data.githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="telemetry-btn-secondary text-sm"
              >
                <span>Código en GitHub</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7"></path>
                  <path d="M7 7h10v10"></path>
                </svg>
              </a>
            )}
          </div>
        )}
      </header>

      <section class="max-w-[68ch] text-base sm:text-[1.0625rem] leading-relaxed text-page-text flex flex-col gap-5 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-1 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-5 [&_p]:m-0 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:my-1 [&_a]:text-primary [&_a]:underline [&_pre]:bg-surface [&_pre]:border [&_pre]:border-card-border [&_pre]:p-4 [&_pre]:rounded-md [&_pre]:overflow-x-auto [&_pre]:text-sm">
        <Content />
      </section>
    </article>
  </div>
</Layout>

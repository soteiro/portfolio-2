---
// projects/index.astro — hub de proyectos
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';
import { sortProjects, trackCode } from '../../lib/projects';
import { absoluteUrl, breadcrumbSchema, personSchema } from '../../lib/seo';

export const prerender = true;

const entries = sortProjects(await getCollection('projects', ({ data }) => !data.draft));

const projects = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  subtitle: entry.data.subtitle,
  description: entry.data.description,
  category: entry.data.category,
  tags: entry.data.tags,
  featured: entry.data.featured,
  demoUrl: entry.data.demoUrl ?? undefined,
  githubUrl: entry.data.githubUrl ?? undefined,
  year: entry.data.year ?? undefined,
}));

const categories = [...new Set(projects.map((project) => project.category))];

const jsonLd = JSON.stringify([
  {
    '@type': 'CollectionPage',
    '@id': `${absoluteUrl('/projects')}#page`,
    name: 'Proyectos',
    description:
      'Casos de estudio de sistemas backend, infraestructura Linux y telemetría IoT en producción.',
    url: absoluteUrl('/projects'),
    author: { '@id': personSchema()['@id'] },
    mainEntity: {
      '@type': 'ItemList',
      numberOfItems: projects.length,
      itemListElement: projects.map((project, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: project.title,
        url: absoluteUrl(`/projects/${project.id}`),
      })),
    },
  },
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Proyectos', path: '/projects' },
  ]),
]);
---

<Layout
  title="Proyectos — Backend, Linux & IoT"
  description="Casos de estudio de ingeniería: daemons concurrentes en Go, pipelines de telemetría IoT sobre 15M de eventos mensuales, hardening de servidores Linux y optimización de PostgreSQL."
  jsonLd={jsonLd}
>
  <div class="site-container max-w-[54rem] py-12 sm:py-16 flex flex-col gap-10">
    <header class="flex flex-col gap-5 pb-8 border-b border-card-border">
      <h1 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold tracking-tight leading-tight text-page-text m-0">
        Proyectos de <span class="text-ring-text">ingeniería</span>
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-[62ch] m-0">
        Sistemas que construí y sostuve en producción: daemons concurrentes en Go con aislamiento a nivel de kernel, telemetría IoT a gran escala, automatización de infraestructura Linux y optimización de bases de datos.
      </p>

      {categories.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 text-xs text-text-muted pt-1">
          <span class="font-medium">{categories.join(' · ')}</span>
          <span>—</span>
          <span class="tabular-data text-primary font-semibold">
            {projects.length} {projects.length === 1 ? 'proyecto' : 'proyectos'}
          </span>
        </div>
      )}
    </header>

    {projects.length > 0 ? (
      <div class="flex flex-col gap-5">
        {projects.map((project, index) => (
          <ProjectCard project={project} trackCode={index < 4 ? trackCode(index) : undefined} />
        ))}
      </div>
    ) : (
      <p class="text-base text-text-muted m-0">
        Todavía no hay proyectos publicados.
      </p>
    )}
  </div>
</Layout>

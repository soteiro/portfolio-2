---
// 404.astro — página de error
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.dateValue.valueOf() - a.data.dateValue.valueOf())
  .slice(0, 3);
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe o cambió de dirección."
  noindex
>
  <div class="site-container max-w-[52rem] py-14 sm:py-20 flex flex-col gap-8">
    <header class="flex flex-col gap-4">
      <h1 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold tracking-tight leading-tight text-page-text m-0">
        404 — Esta página no <span class="text-ring-text">existe</span>
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-[56ch] m-0">
        La dirección es incorrecta o el contenido cambió de ubicación. Desde aquí puedes volver al inicio o seguir por alguna de estas rutas.
      </p>
    </header>

    <nav class="flex flex-wrap gap-3" aria-label="Rutas de recuperación">
      <a href="/" class="telemetry-btn-primary text-sm">Ir al inicio</a>
      <a href="/projects" class="telemetry-btn-secondary text-sm">Ver proyectos</a>
      <a href="/blog" class="telemetry-btn-secondary text-sm">Leer el blog</a>
      <a href="/about" class="telemetry-btn-secondary text-sm">Sobre mí</a>
    </nav>

    {posts.length > 0 && (
      <section class="flex flex-col gap-3 pt-6 border-t border-card-border">
        <h2 class="font-display text-base font-bold text-page-text m-0">
          Artículos recientes
        </h2>
        <ul class="flex flex-col gap-1 list-none p-0 m-0">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="inline-flex items-center min-h-11 text-[0.9375rem] font-medium text-page-text hover:text-primary hover:underline transition-colors"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

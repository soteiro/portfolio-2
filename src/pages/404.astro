---
// 404.astro — página de error. Antes no existía: los slugs inválidos
// redirigían a /404 y terminaban en el error genérico de Cloudflare.
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export const prerender = true;

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.dateValue.valueOf() - a.data.dateValue.valueOf())
  .slice(0, 3);
---

<Layout
  title="Página no encontrada"
  description="La página que buscás no existe o cambió de dirección."
  noindex
>
  <div class="site-container max-w-[50rem] relative z-10 -mt-12 pt-8 pb-20 flex flex-col gap-8">
    <header class="flex flex-col gap-4">
      <span class="text-[0.8125rem] font-bold uppercase tracking-[0.125rem] text-secondary">
        Error 404
      </span>
      <h1 class="text-3xl sm:text-4xl md:text-[2.75rem] font-bold tracking-tight leading-tight m-0">
        Esta página no <span class="text-primary">existe</span>
      </h1>
      <p class="text-lg sm:text-xl text-text-muted leading-relaxed m-0">
        La dirección es incorrecta o el contenido se movió. Desde acá podés volver al inicio o seguir por alguno de estos caminos.
      </p>
    </header>

    <nav class="flex flex-wrap gap-3">
      <a
        href="/"
        class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-primary text-white hover:opacity-90 transition duration-200 no-underline"
      >
        Ir al inicio
      </a>
      <a
        href="/projects"
        class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-cloud-300 dark:bg-cloud-500 text-page-text hover:text-primary transition duration-200 no-underline"
      >
        Ver proyectos
      </a>
      <a
        href="/blog"
        class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-cloud-300 dark:bg-cloud-500 text-page-text hover:text-primary transition duration-200 no-underline"
      >
        Leer el blog
      </a>
      <a
        href="/about"
        class="inline-flex items-center px-4 py-2 text-sm font-semibold rounded-lg bg-cloud-300 dark:bg-cloud-500 text-page-text hover:text-primary transition duration-200 no-underline"
      >
        Sobre mí
      </a>
    </nav>

    {posts.length > 0 && (
      <section class="flex flex-col gap-4 pt-4 border-t border-card-border">
        <h2 class="text-sm font-bold uppercase tracking-[0.125rem] text-secondary m-0">
          Artículos recientes
        </h2>
        <ul class="flex flex-col gap-3 list-none p-0 m-0">
          {posts.map((post) => (
            <li>
              <a
                href={`/blog/${post.id}`}
                class="text-[0.9375rem] font-medium text-inherit no-underline hover:text-primary hover:underline transition-colors duration-200"
              >
                {post.data.title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </div>
</Layout>

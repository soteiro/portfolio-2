---
// blog/index.astro — listado de todos los artículos
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { absoluteUrl, breadcrumbSchema, PERSON_ID, WEBSITE_ID } from '../../lib/seo';

export const prerender = true;

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.dateValue.valueOf() - a.data.dateValue.valueOf()
);

const categories = [...new Set(posts.map((post) => post.data.category))];

const jsonLd = JSON.stringify([
  {
    '@type': 'Blog',
    '@id': `${absoluteUrl('/blog')}#blog`,
    name: 'Artículos & Casos de Estudio',
    description:
      'Ingeniería de sistemas backend en Go, telemetría IoT, Linux y optimización de bases de datos en producción.',
    url: absoluteUrl('/blog'),
    author: { '@id': PERSON_ID },
    publisher: { '@id': PERSON_ID },
    isPartOf: { '@id': WEBSITE_ID },
    blogPost: posts.map((post) => ({
      '@type': 'BlogPosting',
      '@id': `${absoluteUrl(`/blog/${post.id}`)}#article`,
      headline: post.data.title,
      description: post.data.excerpt,
      url: absoluteUrl(`/blog/${post.id}`),
      datePublished: post.data.dateValue.toISOString(),
      dateModified: (post.data.updated ?? post.data.dateValue).toISOString(),
      author: { '@id': PERSON_ID },
    })),
  },
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog' },
  ]),
]);
---

<Layout
  title="Blog — Backend en Go, Linux & Telemetría IoT"
  description="Artículos técnicos y casos de estudio sobre sistemas backend concurrentes en Go, telemetría IoT a gran escala, administración de Linux y optimización de PostgreSQL en producción."
  jsonLd={jsonLd}
>
  <div class="site-container max-w-[54rem] py-12 sm:py-16 flex flex-col gap-10">
    <header class="flex flex-col gap-5 pb-8 border-b border-card-border">
      <h1 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold tracking-tight leading-tight text-page-text m-0">
        Artículos y <span class="text-ring-text">casos de estudio</span>
      </h1>
      <p class="text-base sm:text-lg text-text-muted leading-relaxed max-w-[62ch] m-0">
        Notas y lecciones de ingeniería sobre sistemas backend en Go, telemetría IoT a gran escala, administración Linux, bases de datos y desarrollo de software.
      </p>

      {categories.length > 0 && (
        <div class="flex flex-wrap items-center gap-3 text-xs text-text-muted pt-1">
          <span class="font-medium">{categories.join(' · ')}</span>
          <span>—</span>
          <span class="tabular-data text-primary font-semibold">
            {posts.length} {posts.length === 1 ? 'artículo' : 'artículos'}
          </span>
        </div>
      )}
    </header>

    {posts.length > 0 ? (
      <div class="flex flex-col gap-5">
        {posts.map((post) => (
          <article class="group relative p-6 sm:p-7 bg-surface border border-card-border rounded-md flex flex-col gap-2.5 transition-colors duration-150 hover:border-border-strong">
            <h2 class="font-display text-xl sm:text-2xl font-bold leading-snug text-page-text m-0">
              <a
                href={`/blog/${post.id}`}
                class="text-inherit no-underline transition-colors duration-150 group-hover:text-primary hover:underline after:content-[''] after:absolute after:inset-0"
              >
                {post.data.title}
              </a>
            </h2>

            <div class="flex flex-wrap items-center gap-2 text-xs text-text-muted">
              <span class="font-semibold text-secondary">{post.data.category}</span>
              <span>·</span>
              <time class="tabular-data" datetime={post.data.dateValue.toISOString()}>{post.data.date}</time>
              <span>·</span>
              <span class="tabular-data">{post.data.readTime}</span>
            </div>

            {post.data.excerpt && (
              <p class="text-[0.9375rem] text-text-muted leading-relaxed m-0">
                {post.data.excerpt}
              </p>
            )}
          </article>
        ))}
      </div>
    ) : (
      <p class="text-base text-text-muted m-0">
        Todavía no hay artículos publicados.
      </p>
    )}
  </div>
</Layout>

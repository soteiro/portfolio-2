---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import {
  absoluteUrl,
  blogPostingSchema,
  breadcrumbSchema,
  ogImageUrl,
} from '../../lib/seo';

export const prerender = true;

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: CollectionEntry<'blog'> };
const { Content } = await render(post);

const path = `/blog/${post.id}`;
const url = absoluteUrl(path);
const description = post.data.seoDescription ?? post.data.excerpt;
const image = post.data.ogImage ? absoluteUrl(post.data.ogImage) : ogImageUrl(path);
const modified = post.data.updated ?? undefined;
const wordCount = post.body?.trim().split(/\s+/).length ?? undefined;

const jsonLd = JSON.stringify([
  blogPostingSchema({
    title: post.data.title,
    description,
    url,
    image,
    datePublished: post.data.dateValue,
    dateModified: modified,
    section: post.data.category,
    keywords: [post.data.category, ...post.data.tags],
    wordCount,
  }),
  breadcrumbSchema([
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path },
  ]),
]);
---

<Layout
  title={post.data.seoTitle ?? post.data.title}
  description={description}
  type="article"
  image={image}
  publishedTime={post.data.dateValue}
  modifiedTime={modified}
  section={post.data.category}
  tags={post.data.tags}
  jsonLd={jsonLd}
>
  <div class="site-container max-w-[52rem] py-10 sm:py-14">
    <nav class="mb-8" aria-label="Migas de pan">
      <a
        href="/blog"
        class="inline-flex items-center gap-2 min-h-11 text-sm font-medium text-text-muted hover:text-primary transition-colors"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <line x1="19" y1="12" x2="5" y2="12"></line>
          <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
        <span>Volver a los artículos</span>
      </a>
    </nav>

    <article>
      <header class="flex flex-col gap-4 mb-10 pb-8 border-b border-card-border">
        <h1 class="font-display text-3xl sm:text-4xl md:text-[2.75rem] font-extrabold tracking-tight leading-tight text-page-text m-0">
          {post.data.title}
        </h1>

        <div class="flex flex-wrap items-center gap-2.5 text-xs text-text-muted">
          <span class="font-semibold text-secondary">{post.data.category}</span>
          <span>·</span>
          <time class="tabular-data" datetime={post.data.dateValue.toISOString()}>{String(post.data.date)}</time>
          <span>·</span>
          <span class="tabular-data">{post.data.readTime}</span>
          {modified && (
            <>
              <span>·</span>
              <span>
                Actualizado el{' '}
                <time class="tabular-data" datetime={modified.toISOString()}>
                  {modified.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
                </time>
              </span>
            </>
          )}
        </div>

        {post.data.excerpt && (
          <p class="text-base sm:text-lg text-text-muted leading-relaxed m-0">
            {post.data.excerpt}
          </p>
        )}

        {post.data.tags.length > 0 && (
          <p class="tabular-data text-xs text-text-muted pt-1 m-0">
            {post.data.tags.join(' · ')}
          </p>
        )}
      </header>

      <section class="max-w-[68ch] text-base sm:text-[1.0625rem] leading-relaxed text-page-text flex flex-col gap-5 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:mt-8 [&_h2]:mb-1 [&_h3]:font-display [&_h3]:text-xl [&_h3]:font-bold [&_h3]:mt-5 [&_p]:m-0 [&_ul]:list-disc [&_ul]:pl-6 [&_ol]:list-decimal [&_ol]:pl-6 [&_li]:my-1 [&_a]:text-primary [&_a]:underline [&_pre]:bg-surface [&_pre]:border [&_pre]:border-card-border [&_pre]:p-4 [&_pre]:rounded-md [&_pre]:overflow-x-auto [&_pre]:text-sm">
        <Content />
      </section>
    </article>
  </div>
</Layout>

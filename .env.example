# Keystatic se ejecuta únicamente en local (almacenamiento en disco), así que
# no hace falta ninguna variable de entorno para editar contenido:
#
#   pnpm dev  ->  http://localhost:4321/keystatic
#
# El editor escribe directamente en src/content/. Los cambios se publican
# haciendo commit y push; Cloudflare reconstruye el sitio.
#
# La integración de Keystatic no se incluye en el build de producción
# (ver astro.config.mjs), por lo que /keystatic no existe en el sitio desplegado.

# ---------------------------------------------------------------------------
# Solo si algún día querés editar desde el sitio desplegado: haría falta pasar
# keystatic.config.ts a storage GitHub y definir estas credenciales como
# secretos del Worker (`wrangler secret put NOMBRE`).
#
# KEYSTATIC_GITHUB_CLIENT_ID="tu-github-client-id"
# KEYSTATIC_GITHUB_CLIENT_SECRET="tu-github-client-secret"
# KEYSTATIC_SECRET="clave-aleatoria-de-32-caracteres-o-mas"
# PUBLIC_KEYSTATIC_GITHUB_APP_SLUG="slug-de-tu-github-app"
# PUBLIC_KEYSTATIC_REPO_OWNER="soteiro"
# PUBLIC_KEYSTATIC_REPO_NAME="portfolio-2"

# ---------------------------------------------------------------------------
# SEO y analítica (todas opcionales; sin valor, el tag simplemente no se emite)
# ---------------------------------------------------------------------------

# Cloudflare Web Analytics: Dashboard -> Analytics & Logs -> Web Analytics ->
# el sitio -> "Manage site" -> token del snippet JS.
# PUBLIC_CLOUDFLARE_ANALYTICS_TOKEN="tu-token-de-cloudflare"

# Verificación de propiedad en Search Console. Solo hace falta si elegís el
# método "etiqueta HTML"; verificando por DNS en Cloudflare no se usa.
# PUBLIC_GOOGLE_SITE_VERIFICATION="codigo-de-verificacion"

# Bing Webmaster Tools (equivalente al anterior).
# PUBLIC_BING_SITE_VERIFICATION="codigo-de-verificacion"
